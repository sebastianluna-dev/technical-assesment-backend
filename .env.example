# Copy to .env (ignored by Git) and fill in. Never commit real values.
NODE_ENV=development
PORT=3000

# Required. Base64-encoded 32-byte key for AES-256-GCM. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Optional. JSON file that stores audit records (default: data/audit-log.json).
AUDIT_LOG_PATH=data/audit-log.json

# Optional. Circuit breaker around the AI call.
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_RESET_MS=30000

# Optional. Probability (0 to 1) that the mock AI fails; use 1 to see the 503 path.
MOCK_AI_FAILURE_RATE=0
